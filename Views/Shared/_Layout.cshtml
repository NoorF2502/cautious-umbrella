<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Accountant Portal</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">Accountant Portal</a>
        <nav>
            <a asp-controller="ClientDashboard" asp-action="Index">Client Dashboard</a>
            <a asp-controller="Documents" asp-action="Index">My Documents</a>
            <a asp-controller="AccountantDashboard" asp-action="Index">Accountant Dashboard</a>
            <a asp-controller="AccountantDashboard" asp-action="MyClients">My Clients</a>
        </nav>
    </header>
    <main class="container">
        @if (TempData["Success"] is string success)
        {
            <div class="alert success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert error">@error</div>
        }
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
