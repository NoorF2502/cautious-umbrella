<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cautious Umbrella</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a asp-controller="Home" asp-action="Index" class="brand">Cautious Umbrella</a>
        <nav>
            <a asp-controller="Client" asp-action="Dashboard">Client Dashboard</a>
            <a asp-controller="Accountant" asp-action="Dashboard">Accountant Dashboard</a>
        </nav>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
