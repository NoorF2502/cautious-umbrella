@model LoginViewModel
@{
    ViewData["Title"] = "Accountant login";
}
<h1>Accountant login</h1>
<form asp-action="Login" method="post" class="card">
    <div asp-validation-summary="ModelOnly"></div>
    <label asp-for="Email"></label><input asp-for="Email" /> <span asp-validation-for="Email"></span>
    <label asp-for="Password"></label><input asp-for="Password" /> <span asp-validation-for="Password"></span>
    <div class="actions"><button type="submit">Log in</button><a asp-action="Register">Create account</a></div>
</form>
