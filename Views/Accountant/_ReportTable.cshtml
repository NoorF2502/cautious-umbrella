@model IEnumerable<Report>
<table>
    <thead><tr><th>Title</th><th>Document</th><th>Income</th><th>Expenses</th><th>Taxable</th><th>Tax due</th><th>Payment</th><th>Comments</th></tr></thead>
    <tbody>
    @foreach (var report in Model)
    {
        <tr>
            <td>@report.Title</td>
            <td>@report.Document?.OriginalFileName</td>
            <td>@report.Income.ToString("C")</td>
            <td>@report.Expenses.ToString("C")</td>
            <td>@report.TaxableAmount.ToString("C")</td>
            <td>@report.TaxDue.ToString("C")</td>
            <td><span class="badge">@report.PaymentStatus</span> @report.PaymentAmount.ToString("C")</td>
            <td>@report.AccountantComments</td>
        </tr>
    }
    </tbody>
</table>
