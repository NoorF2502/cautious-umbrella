@model IEnumerable<Document>
@{
    ViewData["Title"] = "My documents";
}
<h1>My documents</h1>
@if (TempData["Message"] is string message)
{
    <p class="card">@message</p>
}
<div class="actions"><a class="button" asp-action="UploadDocument">Upload document</a><a asp-action="Dashboard">Back to dashboard</a></div>
<partial name="_DocumentTable" model="Model" />
