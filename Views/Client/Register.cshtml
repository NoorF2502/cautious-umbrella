@model ClientRegisterViewModel
@{
    ViewData["Title"] = "Client registration";
}
<h1>Client registration</h1>
<form asp-action="Register" method="post" class="card">
    <div asp-validation-summary="ModelOnly"></div>
    <label asp-for="FullName"></label><input asp-for="FullName" /> <span asp-validation-for="FullName"></span>
    <label asp-for="Email"></label><input asp-for="Email" /> <span asp-validation-for="Email"></span>
    <label asp-for="Password"></label><input asp-for="Password" /> <span asp-validation-for="Password"></span>
    <label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" />
    <label asp-for="Address"></label><input asp-for="Address" />
    <label asp-for="AccountantId"></label>
    <select asp-for="AccountantId" asp-items="@(new SelectList(Model.AvailableAccountants, nameof(Accountant.Id), nameof(Accountant.FullName)))">
        <option value="">Assign later</option>
    </select>
    <div class="actions"><button type="submit">Create client account</button><a asp-action="Login">Already registered?</a></div>
</form>
